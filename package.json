{
  "name": "notecraft",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "npx tsx src/lib/renderer/obsidian-transforms.test.ts",
    "cf:build": "npx @opennextjs/cloudflare build",
    "cf:dev": "npx wrangler dev",
    "cf:preview": "npm run cf:build && npx wrangler dev",
    "cf:deploy": "npm run cf:build && npx wrangler deploy"
  },
  "dependencies": {
